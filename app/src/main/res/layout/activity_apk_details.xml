<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/tvPackageNameHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"/>

        <!-- General Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Info"
                    android:textColor="@color/green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                
                <TextView android:id="@+id/tvVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvAppType" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvMinSdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvTargetSdk" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvInstaller" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvInstallTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvUpdateTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Manifest Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Application Manifest"
                    android:textColor="@color/green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decompile and inspect the full AndroidManifest.xml file to view declared permissions, intent filters, activities, and metadata."
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>
                
                <Button
                    android:id="@+id/btnViewManifest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Full Manifest"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/green_primary"
                    app:strokeColor="@color/green_primary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Security Flags Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security Flags"
                    android:textColor="@color/green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                
                <TextView android:id="@+id/tvDebuggable" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/tvDebuggableRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#BBBBBB" android:layout_marginBottom="8dp" android:visibility="gone" android:textIsSelectable="true"/>
                
                <TextView android:id="@+id/tvAllowBackup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/tvAllowBackupRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#BBBBBB" android:layout_marginBottom="8dp" android:visibility="gone" android:text="Implication: Data can be extracted via 'adb backup' even without root."/>
                
                <TextView android:id="@+id/tvCleartext" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/tvCleartextRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#BBBBBB" android:layout_marginBottom="8dp" android:visibility="gone" android:text="Implication: Sensitive data may be transmitted unencrypted (HTTP)."/>

                <TextView android:id="@+id/tvNetworkSecurity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp"/>
                <TextView android:id="@+id/tvNetworkSecurityRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#BBBBBB" android:layout_marginBottom="8dp" android:visibility="gone" android:text="Implication: Network security rules not defined. App will trust system anchors only, but cleartext may be allowed by default on older versions."/>
                
                <TextView android:id="@+id/tvSharedUid" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvAppUid" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/tvSignature" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="12sp" android:layout_marginBottom="12dp" android:textIsSelectable="true"/>

                <Button
                    android:id="@+id/btnFindSisterApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find Sister Apps (Shared UID)"
                    android:visibility="gone"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/green_primary"
                    app:strokeColor="@color/green_primary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Components Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Component Summary"
                    android:textColor="@color/green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                
                <TextView android:id="@+id/tvCompActivities" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvCompServices" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvCompReceivers" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvCompProviders" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Paths Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage Paths"
                    android:textColor="@color/green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                
                <TextView android:id="@+id/tvDataDir" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvSourceDir" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvNativeLibDir" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Permissions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permissions"
                    android:textColor="@color/green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Granted  |  ✗ Requested (Not Granted)"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>
                
                <LinearLayout
                    android:id="@+id/llPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
