<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/main_background"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deeplink &amp; Scheme Auditor"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvPackageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:singleLine="true"/>

    <!-- Discovered Deeplinks Panel (Top 55%) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5.5"
        app:cardBackgroundColor="#CC222222"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discovered Deeplinks &amp; Custom Schemes"
                android:textColor="@color/green_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDeeplinks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"/>

                <TextView
                    android:id="@+id/tvNoDeeplinks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="No implicit deeplinks or custom schemes discovered in this app's manifest."
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Fuzzing & Testing Console Panel (Bottom 4.5) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.5"
        app:cardBackgroundColor="#DD1A1A1A"
        app:cardCornerRadius="8dp"
        app:cardElevation="6dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interactive Intent Fuzzer (Sandbox)"
                    android:textColor="#FF8A00"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- SECTION 1: TARGET URI DEFINITION -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 TARGET URI DEFINITION"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select a deep link from the scanner above or type a custom URI below to populate the target parameter:"
                            android:textColor="#88FFFFFF"
                            android:textSize="10sp"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etDeeplinkUri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:hint="e.g. scheme://host/path?param=val"
                            android:textColor="@color/white"
                            android:textColorHint="#55FFFFFF"
                            android:background="#22FFFFFF"
                            android:padding="8dp"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:inputType="textUri"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SECTION 2: EXPLICIT ROUTING TESTER -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1FEE3B3B"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚀 EXPLICIT INTENT TEST (DIRECT LAUNCH)"
                            android:textColor="#FF8B8B"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Launches target activity directly by setting its explicit package. This bypasses the OS Chooser to verify how the audited application handles inputs inside its Sandbox."
                            android:textColor="#B0FFFFFF"
                            android:textSize="10sp"
                            android:layout_marginBottom="10dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginRight="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Intent Action:"
                                    android:textColor="#88FFFFFF"
                                    android:textSize="10sp"
                                    android:layout_marginBottom="2dp"/>

                                <Spinner
                                    android:id="@+id/spAction"
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:background="#22FFFFFF"/>
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnLaunchIntent"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="LAUNCH TEST"
                                android:backgroundTint="#FF4D4D"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SECTION 3: IMPLICIT ROUTING HIJACKER -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1F00FF00"
                    app:cardCornerRadius="8dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 IMPLICIT INTENT HIJACKER (COLLISION)"
                            android:textColor="@color/green_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulates an attacker on the OS. Launches intent with no explicit package target, forcing the Android System Chooser to trigger. If custom schemes conflict or autoVerify fails, you can intercept the link via MoPWN."
                            android:textColor="#B0FFFFFF"
                            android:textSize="10sp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Destination OOB Server IP/Port:"
                            android:textColor="#88FFFFFF"
                            android:textSize="10sp"
                            android:layout_marginBottom="4dp"/>

                        <EditText
                            android:id="@+id/etOobEndpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:hint="http://127.0.0.1:1337/"
                            android:textColor="@color/white"
                            android:textColorHint="#44FFFFFF"
                            android:background="#15FFFFFF"
                            android:padding="8dp"
                            android:textSize="12sp"
                            android:inputType="textUri"
                            android:layout_marginBottom="10dp"/>

                        <Button
                            android:id="@+id/btnSimulateHijack"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="SIMULATE HIJACK"
                            android:backgroundTint="#00FF00"
                            android:textColor="#121212"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Console Output log -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fuzzer Console Output:"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvConsoleLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:background="#11000000"
                    android:padding="8dp"
                    android:text="Console ready. Select a discovered deeplink above or input a custom URI string to begin."
                    android:textColor="#00FF00"
                    android:textSize="11sp"
                    android:typeface="monospace"/>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

</LinearLayout>
