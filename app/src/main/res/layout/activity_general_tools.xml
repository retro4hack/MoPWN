<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:fillViewport="true"
    tools:context=".GeneralToolsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <TextView
            android:id="@+id/tvGeneralTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="General Tools"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="On-device auditing and analysis utilities"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <!-- ================= FREE-TO-USE GENERAL TOOLS ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FREE-TO-USE GENERAL TOOLS"
            android:textColor="@color/green_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Device Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Hardware &amp; Security Specs"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvDeviceAbi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"
                    android:text="CPU ABI: Loading..."/>

                <TextView
                    android:id="@+id/tvDeviceBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"
                    android:text="Model: Loading..."/>

                <TextView
                    android:id="@+id/tvDeviceAndroidVer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"
                    android:text="OS Version: Loading..."/>

                <TextView
                    android:id="@+id/tvDeviceKernel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"
                    android:text="Kernel: Loading..."/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- OOB Hijack & Listener Card (Free-To-Use) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OOB Hijack &amp; Listener Console"
                    android:textColor="@color/green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spins up an embedded HTTP server to intercept Universal Link token leaks and OOB parameters."
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Quick Status Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERVER STATUS"
                            android:textColor="#88FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvGeneralOobStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OFFLINE"
                            android:textColor="#757575"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENDPOINT"
                            android:textColor="#88FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvGeneralOobEndpoint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="None (Stopped)"
                            android:textColor="#757575"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnNavigateOob"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Open OOB Console"
                    android:backgroundTint="#00AA00"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#555555"
            android:layout_marginBottom="16dp"/>

        <!-- ================= ROOT TOOLS ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROOT GENERAL TOOLS"
            android:textColor="#FF5555"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Frida Server Navigation Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frida Server Manager"
                    android:textColor="#FF5555"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download, install, start, and stop the Frida Server process on this device via root privileges."
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Quick Status Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INSTALLATION"
                            android:textColor="#88FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvGeneralFridaInstallStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking..."
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROCESS"
                            android:textColor="#88FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvGeneralFridaRunStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking..."
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERSION"
                            android:textColor="#88FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvGeneralFridaVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnNavigateFrida"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Manage Frida Server"
                    android:backgroundTint="#AA2222"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Foreground Tracker Root Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active App &amp; Class Tracker"
                    android:textColor="#FF5555"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tracks the active package and class currently shown on screen in a persistent notification bar with rapid copy/stop triggers (Root Required)."
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enable Live Tracker"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchTracker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="false"
                        android:theme="@style/Widget.MaterialComponents.CompoundButton.Switch" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
