<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    tools:context=".SourceViewerActivity"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvClassTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnCopyCode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvClassSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvClassTitle" />

    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvClassSubtitle">

        <EditText
            android:id="@+id/etCodeSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Find in code..."
            android:textColor="@color/white"
            android:textColorHint="#88FFFFFF"
            android:backgroundTint="@color/green_primary"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:layout_marginHorizontal="8dp"
            android:text="0/0" />

        <ImageButton
            android:id="@+id/btnPrevMatch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/arrow_up_float"
            android:contentDescription="Previous Match"
            app:tint="@color/green_primary" />

        <ImageButton
            android:id="@+id/btnNextMatch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/arrow_down_float"
            android:contentDescription="Next Match"
            app:tint="@color/green_primary" />

    </LinearLayout>

    <Button
        android:id="@+id/btnCopyCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Copy Code"
        android:textSize="12sp"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="@color/green_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch" />

    <ScrollView
        android:id="@+id/scrollViewCode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvSourceCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:typeface="monospace"
                android:textIsSelectable="true"
                android:padding="8dp"
                android:text="Decompiling class, please wait..." />

        </HorizontalScrollView>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
